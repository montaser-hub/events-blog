<%# locals: event %>
<article class="event-card cat-<%= h.slug(event.category) %> <%= event.isPast ? 'is-past' : '' %>">
  <div class="event-card__top">
    <span class="event-card__category"><%= event.category %></span>
    <div class="date-chip" aria-hidden="true">
      <span class="date-chip__month"><%= h.month(event.date) %></span>
      <span class="date-chip__day"><%= h.day(event.date) %></span>
    </div>
  </div>
  <div class="event-card__body">
    <h3 class="event-card__title">
      <a class="stretched-link" href="/events/<%= event.id %>"><%= event.title %></a>
    </h3>
    <ul class="event-meta list-unstyled">
      <li><i class="bi bi-clock"></i> <%= h.date(event.date) %> · <%= h.time(event.date) %></li>
      <li><i class="bi bi-geo-alt"></i> <%= event.location %></li>
    </ul>
    <p class="event-card__desc"><%= event.description %></p>
  </div>
  <div class="event-card__foot">
    <span class="d-flex align-items-center gap-2 text-truncate">
      <%- include('avatar', { person: event.organizer, size: 'sm' }) %>
      <span class="text-truncate"><%= event.organizer ? event.organizer.name : 'Unknown' %></span>
    </span>
    <% if (event.isPast) { %>
    <span class="badge text-bg-secondary">Past</span>
    <% } else if (event.isFull) { %>
    <span class="badge text-bg-danger">Full</span>
    <% } else { %>
    <span class="attending"><i class="bi bi-people-fill"></i> <%= event.attendees.length %><%= event.capacity ? ' / ' + event.capacity : '' %></span>
    <% } %>
  </div>
</article>
