<%- include('../partials/head') %>

<section class="container section auth">
  <div class="panel auth__card">
    <h1 class="panel__heading">Welcome back</h1>
    <p class="text-body-secondary mb-4">Log in to create events and save your spot.</p>

    <form action="/users/login" method="post">
      <input type="hidden" name="_csrf" value="<%= csrfToken() %>" />
      <div class="mb-3">
        <label for="email" class="form-label">Email</label>
        <input type="email" class="form-control" id="email" name="email" required autocomplete="email" autofocus />
      </div>
      <div class="mb-4">
        <label for="password" class="form-label">Password</label>
        <input type="password" class="form-control" id="password" name="password" required autocomplete="current-password" />
      </div>
      <button type="submit" class="btn btn-brand w-100">Log in</button>
    </form>
    <p class="auth__switch">New here? <a href="/users/signup">Create an account</a></p>
  </div>
</section>

<%- include('../partials/foot') %>
