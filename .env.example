# Copy to .env and adjust.
NODE_ENV=development
PORT=3000

# MongoDB — the docker-compose service listens on 27019.
# For Atlas use your mongodb+srv:// URI. Never commit real credentials.
MONGO_URI=mongodb://127.0.0.1:27019/events_blog

# Long random string, e.g. `openssl rand -hex 32`
SESSION_SECRET=change-me
